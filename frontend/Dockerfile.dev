# ──────────────────────────────────────────────
#  Frontend — Development Dockerfile
#  Runs the Vite dev server with HMR (hot module
#  replacement).  Source code is mounted as a
#  volume by docker-compose.yml, so edits are
#  reflected instantly in the browser.
# ──────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Port 5173 is the Vite default dev server port
EXPOSE 5173

# vite.config.js has server.host: true so it
# binds to 0.0.0.0 and is reachable from outside
# the container.
CMD ["npm", "run", "dev"]
