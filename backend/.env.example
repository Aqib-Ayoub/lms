# ──────────────────────────────────────────────
#  Backend environment variables
#  Copy this file to .env and fill in the values
#  cp backend/.env.example backend/.env
# ──────────────────────────────────────────────

# Server port (must match Dockerfile EXPOSE and docker-compose port mapping)
PORT=5000

# MongoDB connection string
# In Docker: use the service name (mongo) instead of localhost
# MONGO_URI is overridden in docker-compose.yml — this value is
# only used when running the backend locally (outside Docker)
MONGO_URI=mongodb://localhost:27017/lms

# JWT signing secret — CHANGE THIS to a long random string in production!
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# Allowed CORS origins (comma-separated, no spaces)
# Dev:  http://localhost:5173,http://localhost:3000
# Prod: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
